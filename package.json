{
	"name": "toolhub-evolved",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . --max-warnings 0",
		"lint:css": "stylelint \"public_html/styles/**/*.css\"",
		"spell": "cspell --no-progress \"public_html/**/*.{js,mjs,css,html}\" \"tools/**/*.mjs\" \"*.md\" \"docs/**/*.md\" \"skills/**/*.md\" \"proxy/**/*.py\"",
		"types": "tsc -p jsconfig.json",
		"dead:check": "knip --production",
		"dup:check": "jscpd --config .jscpd.json",
		"dup:check:py": "jscpd --config .jscpd.python.json",
		"checks": "node tools/checks.mjs",
		"clean:prod": "node tools/production-clean-check.mjs",
		"features:docs": "node tools/feature-docs.mjs",
		"features:docs:check": "node tools/feature-docs.mjs --check",
		"changelog:generate": "python3 tools/build_changelog.py --markdown-output CHANGELOG.md && prettier --write CHANGELOG.md",
		"changelog:marketing": "python3 tools/generate_marketing_changelog.py",
		"budget": "node tools/js-budget.mjs",
		"i18n:extract": "node tools/i18n-extract.mjs",
		"i18n:check": "node tools/i18n-extract.mjs --check",
		"lint:banana": "banana-checker --requireLowerCase=false public_html/i18n/",
		"coverage:proxy": "coverage report --include='proxy/app.py,proxy/crawl.py' --fail-under=100",
		"test:unit": "vitest run",
		"coverage": "vitest run --coverage && node tools/js-coverage-ratchet.mjs",
		"coverage:update": "vitest run --coverage && node tools/js-coverage-ratchet.mjs --update",
		"test:e2e": "playwright test",
		"mutation": "stryker run",
		"commitlint": "commitlint --from origin/main --to HEAD",
		"secrets": "gitleaks dir . -c .gitleaks.toml --redact --no-banner",
		"preflight": "node tools/preflight.mjs",
		"audit:js": "node tools/audit-js.mjs",
		"hooks:install": "tools/install-hooks.sh"
	},
	"lint-staged": {
		"*.{js,mjs}": [
			"eslint --fix --max-warnings 0",
			"prettier --write"
		],
		"*.css": [
			"stylelint --fix",
			"prettier --write"
		],
		"*.{json,md,yml,yaml,html,svg}": "prettier --write"
	},
	"overrides": {
		"typed-rest-client": {
			"qs": "^6.16.0"
		},
		"nanoid": "^3.3.18",
		"js-yaml": "^5.4.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.62.1",
		"@stryker-mutator/core": "10.0.0",
		"@stryker-mutator/vitest-runner": "10.0.0",
		"@vitest/coverage-v8": "4.1.11",
		"cspell": "10.2.0",
		"eslint": "10.9.1",
		"eslint-plugin-headers": "1.3.4",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-sonarjs": "4.2.0",
		"eslint-plugin-unicorn": "74.0.0",
		"espree": "11.2.0",
		"globals": "17.11.0",
		"grunt-banana-checker": "0.13.0",
		"happy-dom": "20.12.0",
		"jscpd": "5.1.1",
		"knip": "6.34.0",
		"lint-staged": "17.4.1",
		"prettier": "3.9.6",
		"stylelint": "17.14.1",
		"stylelint-config-standard": "40.0.0",
		"stylelint-declaration-strict-value": "1.12.1",
		"ts-api-utils": "2.5.0",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	}
}
