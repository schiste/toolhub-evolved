# Backend local database + local CI venv
proxy/var/
*.sqlite3
.venv-ci/

# Playwright MCP scratch output (browser snapshots taken while debugging)
.playwright-mcp/

# Playwright run output: screenshots, traces, and *-storage.json session state.
# The storage files hold signed-in cookies, so this must never be committable —
# it appeared untracked and unignored once, one `git add -A` away from putting a
# live session in the history.
output/

# aethyme-broker:begin (managed block — do not edit inside)
.aethyme/broker.db*
.aethyme/logs/
.aethyme/run/
.aethyme/worktrees/
.aethyme/broker-action-required.md
# aethyme-broker:end

# Aethyme deployment telemetry and reports are machine-local runtime state.
.aethyme/reports/
.aethyme/generated/experience-telemetry.jsonl
.aethyme/generated/experience-status.json
.aethyme/generated/experience-status.md

# Broker mutex markers for in-flight operations: empty files whose existence
# is the lock. They belong with the managed block above, but that block is
# regenerated by aethyme and rejects hand-edits, so the rule lives out here.
# Four of them reached a commit once, by way of a merge that swept the
# working tree, and rode all the way to production.
.aethyme/locks/
